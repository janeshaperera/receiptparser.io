# ReceiptParser.io - Environment Variables

# Node environment: development | production | test
NODE_ENV=development

# Server Port
PORT=3000

# PostgreSQL Connection String (Supabase compatible)
# e.g., postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stripe Billing Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_starter_...
STRIPE_PRO_PRICE_ID=price_pro_...

# Development Mocks (NEVER enabled automatically in production)
# Set to true only for local offline testing
MOCK_DB=false
MOCK_LLM=false
MOCK_STRIPE=false

# Allowed Web Origin for CORS
WEB_ORIGIN=http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX=100
