{
  "name": "receiptparser-api",
  "version": "1.0.0",
  "description": "ReceiptParser.io REST API service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --config jest.config.cjs --runInBand --detectOpenHandles --forceExit",
    "db:migrate": "tsx src/db/migrate.ts",
    "smoke": "tsx src/utils/smokeTest.ts"
  },
  "keywords": [
    "receipt",
    "parser",
    "gemini",
    "ocr",
    "invoice"
  ],
  "author": "ReceiptParser.io",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
